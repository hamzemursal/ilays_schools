{
  "name": "school-erp",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @school-erp/database exec prisma generate",
    "db:migrate": "pnpm --filter @school-erp/database exec prisma migrate dev",
    "db:studio": "pnpm --filter @school-erp/database exec prisma studio",
    "db:seed": "pnpm --filter @school-erp/database exec prisma db seed"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  }
}
