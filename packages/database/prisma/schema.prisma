generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organization & School — top of the tenant hierarchy.
// Creating a School only creates its workspace/config, never people or data.
// ---------------------------------------------------------------------------

enum SchoolType {
  PRIMARY
  SECONDARY
  PRIMARY_AND_SECONDARY
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools     School[]
  users       User[]
  students    Student[]
  invitations Invitation[]

  @@map("organizations")
}

model School {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  name    String
  type    SchoolType
  status  SchoolStatus @default(ACTIVE)
  address String?
  phone   String?
  email   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYears      AcademicYear[]
  users              UserSchool[]
  divisions          Division[]
  subjects           Subject[]
  enrollments        StudentEnrollment[]
  teachers           Teacher[]
  // A teacher's own Teacher row lives at exactly one "home" school (above),
  // but a TeacherAssignment may point at a *different* school's section —
  // this is the multi-school teaching relation, kept separate from
  // `teachers` above on purpose.
  teacherAssignments TeacherAssignment[]
  invitations        Invitation[]
  exams              Exam[]
  feeStructures      FeeStructure[]
  importBatches      ImportBatch[]
  announcements      Announcement[]

  // Workforce / HR / Payroll / Finance foundation (Phase 1)
  departments        Department[]
  staff              Staff[]
  // A staff member's own Staff row lives at exactly one "home" school
  // (above), but a StaffAssignment may point at other schools too — same
  // split as `teachers`/`teacherAssignments` above.
  staffAssignments   StaffAssignment[]
  billingPeriods     BillingPeriod[]
  charges            Charge[]
  feeAdjustments     FeeAdjustment[]
  paymentSubmissions PaymentSubmission[]
  expenseCategories  ExpenseCategory[]
  expenses           Expense[]
  salaryHistory      SalaryHistory[]
  payrollPeriods     PayrollPeriod[]
  payslips           Payslip[]
  staffAdvances      StaffAdvance[]
  leaveRequests      LeaveRequest[]
  staffAttendances   StaffAttendance[]

  @@unique([organizationId, name])
  @@map("schools")
}

model AcademicYear {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name      String // e.g. "2026"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments   StudentEnrollment[]
  assignments   TeacherAssignment[]
  exams         Exam[]
  feeStructures FeeStructure[]

  billingPeriods BillingPeriod[]
  charges        Charge[]

  terms Term[]

  @@unique([schoolId, name])
  @@map("academic_years")
}

// Exactly two rows per AcademicYear, always "Term 1" and "Term 2" — created
// together when the year itself is created (see AcademicYearsService), never
// individually. There is deliberately no "create term" endpoint: allowing
// arbitrary term creation would let a Mid-Term or Term 3 slip in, which the
// product explicitly rules out. `weight` is a whole-number percentage
// (0-100); the two terms on one year must always sum to exactly 100 —
// enforced in the service layer, not by a CHECK constraint, since Prisma
// migrations can't express "sum across sibling rows" declaratively.
model Term {
  id             String       @id @default(uuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  name   String // "Term 1" | "Term 2"
  weight Int // whole-number percentage; both terms on a year sum to 100

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exams Exam[]

  @@unique([academicYearId, name])
  @@map("terms")
}

// ---------------------------------------------------------------------------
// Academic structure — School Admin configured. Nothing here is auto-created
// by school creation except AcademicYear defaults the admin still confirms.
// ---------------------------------------------------------------------------

enum DivisionType {
  PRIMARY
  SECONDARY
}

model Division {
  id       String       @id @default(uuid())
  schoolId String
  school   School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  type     DivisionType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes Class[]

  @@unique([schoolId, type])
  @@map("divisions")
}

model Class {
  id         String   @id @default(uuid())
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  name  String // "Class 7" or "Form 2"
  level Int // ordering + promotion target lookup: 1..8 (Primary) or 1..4 (Secondary)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections      Section[]
  classSubjects ClassSubject[]
  enrollments   StudentEnrollment[]
  examSubjects  ExamSubject[]
  feeStructures FeeStructure[]

  @@unique([divisionId, level])
  @@map("classes")
}

model Section {
  id      String @id @default(uuid())
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  name     String // "A", "B", ...
  // Null means unlimited — no maximum enrollment is enforced for this
  // section. A number preserves the original fixed-capacity behavior for
  // sections created before this became optional.
  capacity Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments        StudentEnrollment[]
  teacherAssignments TeacherAssignment[]
  resultSubmissions  ResultSubmission[]

  @@unique([classId, name])
  @@map("sections")
}

model Subject {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name String
  code String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classSubjects ClassSubject[]
  assignments   TeacherAssignment[]
  examSubjects  ExamSubject[]

  @@unique([schoolId, name])
  @@map("subjects")
}

model ClassSubject {
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([classId, subjectId])
  @@map("class_subjects")
}

// ---------------------------------------------------------------------------
// Student identity — permanent, never rewritten. Class/roll/school history
// lives only in StudentEnrollment (see architecture blueprint, section F).
// ---------------------------------------------------------------------------

enum Sex {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  COMPLETED
  GRADUATED
  TRANSFERRED
  WITHDRAWN
  ARCHIVED
}

model Student {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  // Only ever set for a student currently enrolled in a SECONDARY division
  // (see StudentsService.createPortalAccount) — the Student Portal login.
  // Mirrors Guardian.userId/Teacher.userId exactly.
  userId         String?      @unique
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  firstName           String
  lastName            String
  dateOfBirth         DateTime
  sex                 Sex
  legacyStudentNumber String? // preserved from import where applicable, never used as identity
  // Denormalized for fast global lookup/reporting; the authoritative history is
  // always StudentEnrollment.status, transitioned in the same transaction as this.
  currentStatus       StudentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments StudentEnrollment[]
  guardians   StudentGuardian[]
  transfers   Transfer[]

  paymentSubmissions PaymentSubmission[]

  @@index([organizationId, lastName, dateOfBirth])
  @@map("students")
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  // A closed enrollment whose annual result was below the eligibility
  // threshold — the student gets a NEW enrollment in the SAME class for
  // the next academic year (see PromotionsService.confirm), never PROMOTED,
  // so their history correctly shows "Retained" rather than implying they
  // advanced a class.
  RETAINED
  TRANSFERRED_OUT
  COMPLETED
  GRADUATED
  WITHDRAWN
}

model StudentEnrollment {
  id             String       @id @default(uuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  organizationId String
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  classId        String
  class          Class        @relation(fields: [classId], references: [id], onDelete: Restrict)
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  studentNumber String
  rollNumber    Int
  status        EnrollmentStatus @default(ACTIVE)
  startDate     DateTime         @default(now())
  endDate       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transfersOut     Transfer[]        @relation("TransferFrom")
  transfersIn      Transfer[]        @relation("TransferTo")
  promotionFrom    PromotionItem[]   @relation("PromotionFrom")
  promotionTo      PromotionItem[]   @relation("PromotionTo")
  attendances      Attendance[]
  attendanceDrafts AttendanceDraft[]
  results          Result[]
  invoices         Invoice[]
  charges          Charge[]
  feeAdjustments   FeeAdjustment[]

  // Roll number is unique per school+year+class+section — but only among
  // rows sharing the same `status`. Including status in the tuple (rather
  // than just the first five columns) means a closed row (PROMOTED /
  // TRANSFERRED_OUT / etc.) never permanently reserves its roll number: a
  // new ACTIVE row can reuse it in the same section/year, while two ACTIVE
  // rows still can't collide. Postgres has no native way to express "unique
  // only where status = ACTIVE" without a partial index, which Prisma's
  // schema DSL can't declare without drifting on every future migration —
  // this achieves the same real-world guarantee without that risk.
  @@unique([schoolId, academicYearId, classId, sectionId, rollNumber, status])
  // Same reasoning as above: a promoted student keeps the same studentNumber
  // across years (see PromotionsService) and that's fine since the year
  // differs, but within one year a closed enrollment shouldn't permanently
  // block a new active student from getting that same number.
  @@unique([schoolId, academicYearId, studentNumber, status])
  @@index([studentId])
  // The Student Lifecycle system's bucket queries (Primary Completed,
  // Awaiting Enrollment, Secondary Graduated, etc.) all filter on
  // "this school's enrollments in a given status" — schoolId alone was
  // only ever a leftmost-prefix beneficiary of the composite unique index
  // above, whose later columns don't help this access pattern.
  @@index([schoolId, status])
  @@map("student_enrollments")
}

// ---------------------------------------------------------------------------
// Guardians — one account can be the parent of many children across schools.
// ---------------------------------------------------------------------------

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum GuardianStatus {
  ACTIVE
  ARCHIVED
}

model Guardian {
  id     String  @id @default(uuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // System-generated, mirroring Student.legacyStudentNumber/Teacher.employeeNumber
  // — never typed by the admin. Nullable only because guardians created before
  // this field existed have none; every new guardian gets one.
  guardianCode String? @unique

  firstName String
  lastName  String
  phone     String?
  email     String?
  address   String?
  status    GuardianStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students      StudentGuardian[]
  notifications Notification[]

  @@index([phone])
  @@map("guardians")
}

enum StudentGuardianStatus {
  ACTIVE
  INACTIVE
}

model StudentGuardian {
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId String
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  relationship     GuardianRelationship
  isPrimaryContact Boolean               @default(false)
  // INACTIVE means "no longer an active relationship" (e.g. admin removed it)
  // without losing the historical record of who was linked to this student —
  // same non-destructive intent as Guardian.status.
  status           StudentGuardianStatus @default(ACTIVE)

  @@id([studentId, guardianId])
  @@map("student_guardians")
}

// ---------------------------------------------------------------------------
// Announcements & Notifications — minimal, additive: announcements are
// school-authored broadcasts; notifications are the per-guardian inbox rows
// derived from them. Nothing else in the system produces notifications yet,
// so this stays scoped to what the Parent Portal actually needs today rather
// than a general-purpose event bus.
// ---------------------------------------------------------------------------

enum AnnouncementAudience {
  ALL
  PARENTS
  TEACHERS
}

model Announcement {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  title           String
  body            String
  audience        AnnouncementAudience @default(ALL)
  createdByUserId String

  createdAt DateTime @default(now())

  notifications Notification[]

  @@index([schoolId, createdAt])
  @@map("announcements")
}

// Addressed to exactly one of guardianId or userId — never both, never
// neither. Kept as two nullable columns rather than a single polymorphic
// "recipientId" so each side keeps a real foreign key (and real
// onDelete: Cascade) instead of an unenforced string. guardianId is the
// original Parent Portal recipient; userId (added for the Exam Management
// workflow) covers every other actor — Teacher, School Admin, Super Admin —
// through the same User row their login already uses.
model Notification {
  id         String    @id @default(uuid())
  guardianId String?
  guardian   Guardian? @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  title     String
  body      String
  // Where "View" in the notification list should take the reader — e.g.
  // straight to the exam-subject/section results page a return/approve/
  // publish event was about. Never a full origin URL, just the in-app path.
  actionUrl String?
  isRead    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([guardianId, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Teachers — profile is separate from login identity; assignments are what
// actually grant access to a class/section/subject in a given academic year.
// ---------------------------------------------------------------------------

enum TeacherStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

model Teacher {
  id       String  @id @default(uuid())
  userId   String? @unique
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  // Permanent, organization-wide identity — never scoped by school, never
  // reused, never renumbered on transfer/reassignment. Deliberately a
  // second, separate field from employeeNumber (which stays exactly as it
  // was: a per-school payroll/HR number, `@@unique([schoolId,
  // employeeNumber])` below) rather than repurposing it, so no existing
  // data, export, or payslip reference needs to change. Nullable only
  // because it's backfilled by migration for teachers that already existed
  // when this field was introduced; every teacher created from here on
  // gets one immediately (see TeachersService.create).
  teacherCode String? @unique

  employeeNumber String
  firstName      String
  lastName       String
  sex            Sex?
  dateOfBirth    DateTime?
  phone          String?
  email          String?
  address        String?
  qualification  String?
  specialization String?
  employmentDate DateTime?
  status         TeacherStatus @default(ACTIVE)

  // Self-service contact fields (see TeachersService.updateMyProfile) — a
  // teacher may keep these current themselves; everything else on this model
  // is School Admin controlled.
  emergencyContactName  String?
  emergencyContactPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments TeacherAssignment[]

  // Payroll / HR foundation (Phase 1) — a Teacher is payroll-eligible
  // alongside Staff; see SalaryHistory/Payslip/StaffAdvance/LeaveRequest/
  // StaffAttendance below, all of which reference exactly one of
  // teacherId/staffId, never both.
  salaryHistory    SalaryHistory[]
  payslips         Payslip[]
  advances         StaffAdvance[]
  leaveRequests    LeaveRequest[]
  staffAttendances StaffAttendance[]

  @@unique([schoolId, employeeNumber])
  @@map("teachers")
}

model TeacherAssignment {
  id             String       @id @default(uuid())
  teacherId      String
  teacher        Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  // Deliberately independent of Teacher.schoolId (the teacher's home/
  // employment school) — this is what a teacher may teach at, which can be
  // a different school in the same organization than the one that employs
  // them. sectionId alone would already pin the assignment to one real
  // school transitively (Section -> Class -> Division -> School), but a
  // direct, indexed, FK-enforced column here is what makes "every
  // assignment at this school" and "every assignment for this teacher
  // across schools" both cheap, indexed queries instead of a multi-hop join.
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([teacherId, sectionId, subjectId, academicYearId])
  @@index([teacherId, schoolId])
  @@map("teacher_assignments")
}

// ---------------------------------------------------------------------------
// Staff & HR — Staff is the non-teaching workforce, deliberately a sibling
// model to Teacher rather than a shared "Employee" supertype: Teacher already
// carries subject/section/assignment concepts that don't apply to Staff, and
// splitting them keeps each domain's UI and queries simple without a risky
// refactor of the existing, working Teacher module. Department is a plain
// per-school configurable lookup, never a hard-coded list (e.g. no dedicated
// Librarian/Driver modules).
// ---------------------------------------------------------------------------

enum DepartmentStatus {
  ACTIVE
  ARCHIVED
}

model Department {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name   String
  status DepartmentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff       Staff[]
  assignments StaffAssignment[]

  @@unique([schoolId, name])
  @@map("departments")
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

model Staff {
  id           String      @id @default(uuid())
  userId       String?     @unique
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  schoolId     String
  school       School      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Permanent, organization-wide identity — same rationale as
  // Teacher.teacherCode: a second field alongside staffNumber (which stays
  // exactly as it was, per-school), not a replacement for it.
  staffCode String? @unique

  staffNumber    String
  firstName      String
  lastName       String
  sex            Sex?
  dateOfBirth    DateTime?
  phone          String?
  email          String?
  address        String?
  jobTitle       String?
  employmentDate DateTime?
  status         StaffStatus @default(ACTIVE)

  emergencyContactName  String?
  emergencyContactPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salaryHistory    SalaryHistory[]
  payslips         Payslip[]
  advances         StaffAdvance[]
  leaveRequests    LeaveRequest[]
  staffAttendances StaffAttendance[]
  assignments      StaffAssignment[]

  @@unique([schoolId, staffNumber])
  @@map("staff")
}

enum StaffAssignmentStatus {
  ACTIVE
  INACTIVE
}

// The multi-school counterpart to TeacherAssignment — deliberately
// independent of Staff.schoolId (the person's home/employing school),
// same split for the same reason: a staff member's home school controls
// their personal profile and login, but StaffAssignment is what actually
// determines every school they work at and in what role there. status is
// per assignment, not per person — deactivating someone at one school
// (status: INACTIVE here) must never affect their standing at another
// school; Staff.status is a separate, home-school-only HR field.
model StaffAssignment {
  id           String                @id @default(uuid())
  staffId      String
  staff        Staff                 @relation(fields: [staffId], references: [id], onDelete: Cascade)
  schoolId     String
  school       School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  role         String?
  status       StaffAssignmentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, schoolId])
  @@index([staffId])
  @@index([schoolId])
  @@map("staff_assignments")
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Exactly one of teacherId/staffId is set on every row below — the same
// two-real-foreign-keys pattern already used by Notification
// (guardianId/userId), not an unenforced polymorphic id column.
model LeaveRequest {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  type      LeaveType
  startDate DateTime    @db.Date
  endDate   DateTime    @db.Date
  reason    String?
  status    LeaveStatus @default(PENDING)

  requestedByUserId String
  decidedByUserId   String?
  decidedAt         DateTime?
  decisionNote      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId, status])
  @@index([staffId, status])
  @@map("leave_requests")
}

enum StaffAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  EXCUSED
}

// Deliberately separate from Attendance/AttendanceStatus (student
// attendance) — same shape, wholly different domain; workforce attendance
// must never be mixed with student attendance.
model StaffAttendance {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  date           DateTime              @db.Date
  status         StaffAttendanceStatus
  markedByUserId String
  note           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, staffId, date])
  @@map("staff_attendance")
}

// ---------------------------------------------------------------------------
// Attendance — one record per enrollment per day PER SESSION. Authorization
// (a teacher may only mark a section they hold a TeacherAssignment for) is
// enforced in AttendanceService, not here; the schema just needs the
// enrollment link.
//
// Session is a label, never a clock time: this schema has no per-school
// timetable/schedule model (checked before adding this), and nothing in the
// app validates against a real clock — a school running 7am-12pm and one
// running 1pm-5pm both just pick "Morning Session" or "Afternoon Session"
// for whichever period they're marking. Adding literal start/end times would
// mean inventing a scheduling system nothing here currently needs.
//
// Every pre-existing Attendance/AttendanceDraft row defaults to MORNING via
// the migration's column default — this is what preserves every row's
// original meaning ("the one attendance record for that day") as the first,
// primary session, without rewriting or guessing per-row, and without ever
// needing to treat "no session value" as a distinct third state.
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AttendanceSession {
  MORNING
  AFTERNOON
}

model Attendance {
  id           String            @id @default(uuid())
  enrollmentId String
  enrollment   StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  date           DateTime          @db.Date
  session        AttendanceSession @default(MORNING)
  status         AttendanceStatus
  markedByUserId String
  note           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, date, session])
  @@map("attendance_records")
}

// A teacher's in-progress, unfinished attendance for one section+day —
// deliberately a separate table from Attendance, not a status flag on it.
// Every dashboard/report/parent/student-portal query already reads
// Attendance directly as "real, finalized attendance"; keeping drafts out
// of that table entirely means none of those call sites need to remember
// to filter drafts out — they simply never see them. AttendanceService.mark
// (the real "Save attendance") deletes the matching draft rows once it
// writes the real Attendance rows, so a draft never outlives its submission.
model AttendanceDraft {
  id           String            @id @default(uuid())
  enrollmentId String
  enrollment   StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  date          DateTime          @db.Date
  session       AttendanceSession @default(MORNING)
  status        AttendanceStatus
  note          String?
  savedByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, date, session])
  @@map("attendance_drafts")
}

// ---------------------------------------------------------------------------
// Exams & results — marks entry is scoped to a teacher's own
// TeacherAssignment for that class+subject+year; approval locks the mark
// against further edits (see ResultsService).
// ---------------------------------------------------------------------------

enum ExamType {
  QUIZ
  MIDTERM
  FINAL
  ASSIGNMENT
  OTHER
}

model Exam {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  // Nullable so existing exams (created before Term existed) keep working
  // unassigned — never silently backfilled to Term 1 or Term 2, since that
  // would be guessing at historical data. New exams should always set this;
  // an unassigned exam's results are excluded from term/annual calculations
  // (see TermResultsService), not counted toward either term.
  termId         String?
  term           Term?        @relation(fields: [termId], references: [id], onDelete: SetNull)

  name String
  type ExamType

  // The exam period as a whole — distinct from ExamSubject.examDate, which is
  // the specific sitting date for one (class, subject) pair and is what
  // actually drives the printed result sheet. Both optional, same as
  // examDate always has been: plenty of real exams get scheduled before
  // every date is nailed down.
  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  examSubjects ExamSubject[]

  @@unique([schoolId, academicYearId, name])
  @@map("exams")
}

model ExamSubject {
  id        String  @id @default(uuid())
  examId    String
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  maxMarks    Int       @default(100)
  // Stored, not enforced anywhere — this system has no pass/fail policy (see
  // the Phase 8 print-sheet decision not to compute a pass rate), so this is
  // configuration an admin can record, not a value anything currently
  // derives a status from.
  passingMark Int?
  examDate    DateTime? @db.Date

  createdAt DateTime @default(now())

  results           Result[]
  resultSubmissions ResultSubmission[]

  @@unique([examId, classId, subjectId])
  @@map("exam_subjects")
}

// One row per (examSubject, section) — the actual per-teacher unit of work,
// since ExamSubject itself has no section (a class's Mathematics exam is one
// ExamSubject row shared by every section, but Section A and Section B are
// reviewed/returned/approved/published independently by whichever teacher
// holds the TeacherAssignment for that section). Kept as its own table
// rather than a status column on Result, the same way AttendanceDraft is
// kept separate from Attendance — every Result row belongs to exactly one
// submission, and the submission's status is the single source of truth for
// the whole draft->submitted->needs_correction->approved->published
// pipeline, never re-derived from scanning individual Result rows.
enum ResultStatus {
  ENTERED
  APPROVED
}

enum ResultSubmissionStatus {
  DRAFT
  SUBMITTED
  NEEDS_CORRECTION
  APPROVED
  PUBLISHED
}

enum ExamPaperStatus {
  DRAFT
  SUBMITTED
}

model ResultSubmission {
  id            String      @id @default(uuid())
  examSubjectId String
  examSubject   ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  sectionId     String
  section       Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  status ResultSubmissionStatus @default(DRAFT)

  // The teacher's own note about the exam paper/results, shown to the Admin
  // during review — distinct from returnReason, which is the Admin's note
  // back to the teacher.
  notes String?

  // The exam paper's own small lifecycle — independent of `status` above,
  // which tracks the *results* pipeline. Null means no paper has been
  // uploaded yet; the actual file lives in MediaFile
  // (ownerType=RESULT_SUBMISSION, ownerId=this row's id), "latest wins" like
  // a profile photo — re-uploading replaces which file paperStatus/paper*
  // describe, without deleting the older MediaFile rows.
  paperStatus            ExamPaperStatus?
  paperSubmittedByUserId String?
  paperSubmittedAt       DateTime?

  submittedByUserId String?
  submittedAt       DateTime?

  returnedByUserId String?
  returnedAt       DateTime?
  returnReason     String?

  approvedByUserId String?
  approvedAt       DateTime?

  publishedByUserId String?
  publishedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results Result[]

  @@unique([examSubjectId, sectionId])
  @@index([sectionId, status])
  @@map("result_submissions")
}

model Result {
  id                 String            @id @default(uuid())
  examSubjectId      String
  examSubject        ExamSubject       @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  enrollmentId       String
  enrollment         StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  resultSubmissionId String
  resultSubmission   ResultSubmission  @relation(fields: [resultSubmissionId], references: [id], onDelete: Cascade)

  // Null exactly when isAbsent is true (enforced by a CHECK constraint): an
  // absent student has NO mark — never a stored 0. Every reader that sums or
  // averages marks must skip absent rows so absence is never counted as zero.
  marksObtained   Decimal? @db.Decimal(6, 2)
  isAbsent        Boolean  @default(false)
  enteredByUserId String

  // Superseded by ResultSubmission.status — kept only so this migration
  // stays additive (no DROP COLUMN on live data). No code writes or reads
  // these two anymore; a later, separate cleanup can drop them once the new
  // workflow has been live for a while.
  status           ResultStatus @default(ENTERED)
  approvedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examSubjectId, enrollmentId])
  @@map("results")
}

// ---------------------------------------------------------------------------
// Finance — a FeeStructure is the school's own definition of a charge
// (e.g. "Term 1 Tuition — Class 7"); Invoices are generated from it against
// specific enrollments, and Payments are recorded against an invoice.
// Invoice.amount is a snapshot taken at generation time, deliberately
// decoupled from FeeStructure.amount so a later fee-structure edit never
// silently changes an already-issued invoice.
// ---------------------------------------------------------------------------

enum FeeFrequency {
  ONE_TIME
  MONTHLY
  TERMLY
  ANNUAL
}

model FeeStructure {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classId        String? // null = applies across the whole school, not one class
  class          Class?       @relation(fields: [classId], references: [id], onDelete: Cascade)

  name   String
  amount Decimal @db.Decimal(10, 2)

  // Defaults to ONE_TIME so every existing row keeps its current, unchanged
  // meaning (one Invoice per enrollment, exactly today's behavior).
  // MONTHLY/TERMLY fee structures are billed via the new Charge model below,
  // never by weakening Invoice's own one-per-enrollment uniqueness.
  frequency     FeeFrequency @default(ONE_TIME)
  effectiveFrom DateTime?    @db.Date
  effectiveTo   DateTime?    @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]
  charges  Charge[]

  @@unique([schoolId, academicYearId, classId, name])
  @@map("fee_structures")
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model Invoice {
  id             String            @id @default(uuid())
  enrollmentId   String
  enrollment     StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  feeStructureId String
  feeStructure   FeeStructure      @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)

  amount  Decimal       @db.Decimal(10, 2)
  dueDate DateTime?     @db.Date
  status  InvoiceStatus @default(UNPAID)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments           Payment[]
  feeAdjustments     FeeAdjustment[]
  paymentSubmissions PaymentSubmission[]

  // One invoice per fee per enrollment — generating twice must not double-bill.
  @@unique([enrollmentId, feeStructureId])
  @@map("invoices")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
  OTHER
}

enum PaymentStatus {
  POSTED
  REVERSED
}

// A Payment row is only ever created once money has actually been received
// and matched — cash is posted immediately (unchanged from today); a ZAAD
// claim only produces a Payment once PaymentSubmission below is verified.
// There is deliberately no PENDING status here: "pending" lives entirely in
// PaymentSubmission, so a Payment row itself always means "this posted to
// the ledger." REVERSED exists so a mistaken payment can be corrected
// without ever deleting the row (financial history must not be deleted).
model Payment {
  id        String   @id @default(uuid())
  // Exactly one of invoiceId/chargeId is set — a payment posts against
  // either a one-time Invoice or a recurring Charge, never both. invoiceId
  // was NOT NULL before this migration; every existing row already has a
  // value, so relaxing it to optional is a pure loosening, not a data change.
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  chargeId  String?
  charge    Charge?  @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  amount           Decimal       @db.Decimal(10, 2)
  method           PaymentMethod @default(CASH)
  reference        String?
  recordedByUserId String
  paidAt           DateTime      @default(now())

  status           PaymentStatus @default(POSTED)
  reversedByUserId String?
  reversedAt       DateTime?
  reversalReason   String?

  // Human-facing receipt number (e.g. "REC-2026-000123"), assigned by the
  // service layer at posting time. Nullable so existing historical payments
  // (which never had one) remain valid without a backfill.
  receiptNumber String? @unique

  // Traces a ZAAD-originated payment back to the claim that produced it.
  // Null for cash payments and for any payment that predates ZAAD support.
  paymentSubmissionId String?            @unique
  paymentSubmission   PaymentSubmission? @relation(fields: [paymentSubmissionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("payments")
}

// ---------------------------------------------------------------------------
// Recurring billing, adjustments & ZAAD — additive extensions of the Finance
// domain above. Invoice/Payment's existing one-time-fee behavior is
// completely untouched by everything in this section.
// ---------------------------------------------------------------------------

model BillingPeriod {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  name      String // e.g. "January 2026" or "Term 1"
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  createdAt DateTime @default(now())

  charges Charge[]

  @@unique([schoolId, academicYearId, name])
  @@map("billing_periods")
}

enum ChargeStatus {
  OUTSTANDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

// Generalizes Invoice to support recurring (monthly/termly) billing.
// Deliberately a separate model rather than adding billingPeriodId onto
// Invoice: Invoice's existing @@unique([enrollmentId, feeStructureId]) is
// what guarantees "generating twice never double-bills" for the one-time
// fee flow today, and Postgres treats NULLs as distinct within a unique
// index — adding a nullable billingPeriodId to that same constraint would
// silently remove the guarantee for every existing one-time invoice. Charge
// gets its own, equally strict constraint instead; Invoice is untouched.
model Charge {
  id              String            @id @default(uuid())
  schoolId        String
  school          School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId  String
  academicYear    AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  enrollmentId    String
  enrollment      StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  feeStructureId  String
  feeStructure    FeeStructure      @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)
  billingPeriodId String?
  billingPeriod   BillingPeriod?    @relation(fields: [billingPeriodId], references: [id], onDelete: Restrict)

  amount  Decimal      @db.Decimal(10, 2)
  dueDate DateTime?    @db.Date
  status  ChargeStatus @default(OUTSTANDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments           Payment[]
  feeAdjustments     FeeAdjustment[]
  paymentSubmissions PaymentSubmission[]

  @@unique([enrollmentId, feeStructureId, billingPeriodId])
  @@index([schoolId, status])
  @@map("charges")
}

enum FeeAdjustmentType {
  DISCOUNT
  SCHOLARSHIP
  CORRECTION
  WAIVER
}

enum FeeAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

// Never mutates Invoice.amount/Charge.amount directly — an adjustment is its
// own auditable row. A student's balance is always derived as
// charges - posted payments +/- approved adjustments, never an in-place edit
// to a charge/invoice amount.
model FeeAdjustment {
  id           String            @id @default(uuid())
  schoolId     String
  school       School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  invoiceId    String?
  invoice      Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  chargeId     String?
  charge       Charge?           @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  type   FeeAdjustmentType
  amount Decimal             @db.Decimal(10, 2)
  reason String
  status FeeAdjustmentStatus @default(APPROVED)

  requestedByUserId String
  approvedByUserId  String?
  approvedAt        DateTime?

  effectiveFrom DateTime? @db.Date
  effectiveTo   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enrollmentId])
  @@index([schoolId, status])
  @@map("fee_adjustments")
}

enum PaymentSubmissionStatus {
  PENDING
  VERIFIED
  REJECTED
}

// A ZAAD (or any future mobile-money provider) claim — deliberately NOT a
// Payment row. A Payment only ever gets created once Finance verifies this
// and posts it, so a pending or rejected submission can never be mistaken
// for money that has actually reduced a student's balance. Supports both the
// Parent Portal submission path (submittedByUserId set) and the
// finance-discovers-a-direct-deposit path (submittedByUserId null, invoiceId/
// chargeId matched by Finance during verification). providerTransactionReference
// is a plain, provider-agnostic string — never assumed to match a specific
// format — so an official ZAAD API integration later only needs to create
// rows here (pre-verified or auto-matched); the Payment-posting logic below
// it does not change.
model PaymentSubmission {
  id        String  @id @default(uuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  chargeId  String?
  charge    Charge?  @relation(fields: [chargeId], references: [id], onDelete: SetNull)

  amount                       Decimal @db.Decimal(10, 2)
  provider                     String // e.g. "ZAAD" — a plain string, not an enum, so a new provider needs no schema change
  providerTransactionReference String?
  payerPhone                   String?
  payerName                    String?
  submittedByUserId            String? // null when Finance entered a direct deposit Finance discovered, not a parent submission
  note                         String?

  status           PaymentSubmissionStatus @default(PENDING)
  verifiedByUserId String?
  verifiedAt       DateTime?
  rejectionReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment?

  // Duplicate-submission protection, scoped per school+provider. Rows without
  // a reference yet (parent hasn't provided one) aren't deduped by this
  // index — Postgres treats each NULL as distinct — so those still require
  // manual duplicate review by Finance at verification time.
  @@unique([schoolId, provider, providerTransactionReference])
  @@index([schoolId, status])
  @@map("payment_submissions")
}

// ---------------------------------------------------------------------------
// Expenses — school-level spending, separate from payroll and student fees.
// Category is a configurable per-school lookup, same reasoning as Department.
// ---------------------------------------------------------------------------

model ExpenseCategory {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name String

  createdAt DateTime @default(now())

  expenses Expense[]

  @@unique([schoolId, name])
  @@map("expense_categories")
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model Expense {
  id                String           @id @default(uuid())
  schoolId          String
  school            School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  expenseCategoryId String?
  expenseCategory   ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)

  description String
  amount      Decimal       @db.Decimal(10, 2)
  expenseDate DateTime      @db.Date
  status      ExpenseStatus @default(PENDING)

  recordedByUserId String
  approvedByUserId String?
  approvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, status])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Payroll — Teachers AND Staff are eligible; this is a Finance/HR domain,
// never part of the Teacher/Staff list UI itself. Every model below
// references exactly one of teacherId/staffId, same convention as
// LeaveRequest/StaffAttendance above.
// ---------------------------------------------------------------------------

model SalaryHistory {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  basicSalary   Decimal   @db.Decimal(10, 2)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date // null = currently in effect — a raise inserts a new row, never overwrites this one

  createdByUserId String
  createdAt       DateTime @default(now())

  @@index([teacherId, effectiveFrom])
  @@index([staffId, effectiveFrom])
  @@map("salary_history")
}

enum PayrollPeriodStatus {
  OPEN
  CLOSED
}

model PayrollPeriod {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name      String // e.g. "January 2026"
  startDate DateTime            @db.Date
  endDate   DateTime            @db.Date
  status    PayrollPeriodStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payslips Payslip[]

  @@unique([schoolId, name])
  @@map("payroll_periods")
}

enum PayslipStatus {
  DRAFT
  CALCULATED
  REVIEWED
  APPROVED
  PAID
}

// Draft -> Calculated -> Reviewed -> Approved -> Paid, with the actual
// permission checks for each transition enforced in the service layer
// (payroll.prepare/review/approve/pay), not by this schema.
model Payslip {
  id              String        @id @default(uuid())
  payrollPeriodId String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
  schoolId        String
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId       String?
  teacher         Teacher?      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  staffId         String?
  staff           Staff?        @relation(fields: [staffId], references: [id], onDelete: Restrict)

  basicSalary Decimal       @db.Decimal(10, 2)
  grossSalary Decimal       @db.Decimal(10, 2)
  netSalary   Decimal       @db.Decimal(10, 2)
  status      PayslipStatus @default(DRAFT)

  preparedByUserId String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  approvedByUserId String?
  approvedAt       DateTime?
  paidByUserId     String?
  paidAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems         PayslipLineItem[]
  advanceRepayments AdvanceRepayment[]

  @@unique([payrollPeriodId, teacherId, staffId])
  @@index([schoolId, status])
  @@map("payslips")
}

enum PayslipLineType {
  ALLOWANCE
  BONUS
  DEDUCTION
  ADVANCE_REPAYMENT
  OTHER
}

// One flexible, itemized line-item table rather than separate
// Allowance/Deduction/Bonus models — each row is individually auditable,
// which is what the underlying requirement actually needs.
model PayslipLineItem {
  id        String  @id @default(uuid())
  payslipId String
  payslip   Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  type   PayslipLineType
  label  String
  amount Decimal         @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@map("payslip_line_items")
}

enum AdvanceStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model StaffAdvance {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: Restrict)

  amount             Decimal       @db.Decimal(10, 2)
  repaymentPerPeriod Decimal       @db.Decimal(10, 2)
  status             AdvanceStatus @default(ACTIVE)
  issuedByUserId     String
  issuedAt           DateTime      @default(now())
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repayments AdvanceRepayment[]

  @@index([teacherId])
  @@index([staffId])
  @@map("staff_advances")
}

// Every repayment is its own row rather than a running balance field on
// StaffAdvance — the outstanding balance is always derived as
// amount - sum(repayments), the same "derive, never overwrite" rule as the
// student fee ledger.
model AdvanceRepayment {
  id             String       @id @default(uuid())
  staffAdvanceId String
  staffAdvance   StaffAdvance @relation(fields: [staffAdvanceId], references: [id], onDelete: Restrict)
  payslipId      String?
  payslip        Payslip?     @relation(fields: [payslipId], references: [id], onDelete: SetNull)

  amount    Decimal  @db.Decimal(10, 2)
  appliedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@map("advance_repayments")
}

// ---------------------------------------------------------------------------
// Transfers — never delete the student or the source enrollment.
// ---------------------------------------------------------------------------

enum TransferStatus {
  REQUESTED
  APPROVED
  REJECTED
  EXECUTED
  CANCELLED
}

model Transfer {
  id        String  @id @default(uuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  fromEnrollmentId String             @unique
  fromEnrollment   StudentEnrollment  @relation("TransferFrom", fields: [fromEnrollmentId], references: [id], onDelete: Restrict)
  fromSchoolId     String
  toSchoolId       String
  toEnrollmentId   String?            @unique
  toEnrollment     StudentEnrollment? @relation("TransferTo", fields: [toEnrollmentId], references: [id], onDelete: SetNull)

  reason            String?
  // Kept separate from `reason` (the requester's own reason for asking)
  // so a rejection never overwrites why the transfer was requested in the
  // first place — both survive on the same row.
  rejectionReason   String?
  status            TransferStatus @default(REQUESTED)
  requestedByUserId String
  approvedByUserId  String?
  transferDate      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromSchoolId])
  @@index([toSchoolId])
  @@map("transfers")
}

// ---------------------------------------------------------------------------
// Promotion / completion / graduation — batched, previewed, then confirmed.
// ---------------------------------------------------------------------------

enum PromotionBatchStatus {
  DRAFT
  PREVIEWED
  CONFIRMED
  REVERTED
}

enum PromotionOutcome {
  PROMOTED
  RETAINED
  COMPLETED
  GRADUATED
}

model PromotionBatch {
  id                 String               @id @default(uuid())
  schoolId           String
  fromAcademicYearId String
  toAcademicYearId   String
  initiatedByUserId  String
  status             PromotionBatchStatus @default(DRAFT)

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  items PromotionItem[]

  @@map("promotion_batches")
}

model PromotionItem {
  id      String         @id @default(uuid())
  batchId String
  batch   PromotionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  studentId        String
  fromEnrollmentId String             @unique
  fromEnrollment   StudentEnrollment  @relation("PromotionFrom", fields: [fromEnrollmentId], references: [id], onDelete: Restrict)
  toEnrollmentId   String?            @unique
  toEnrollment     StudentEnrollment? @relation("PromotionTo", fields: [toEnrollmentId], references: [id], onDelete: SetNull)

  outcome PromotionOutcome
  note    String?

  @@map("promotion_items")
}

// ---------------------------------------------------------------------------
// Identity & access — RBAC. Resource/school scope is enforced via UserSchool,
// not by the Role alone (see architecture blueprint, section E).
// ---------------------------------------------------------------------------

enum UserStatus {
  PENDING_SETUP
  ACTIVE
  SUSPENDED
}

model User {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  email              String     @unique
  passwordHash       String?
  status             UserStatus @default(PENDING_SETUP)
  // Set on any account whose password was assigned by an admin rather than
  // chosen by the account holder (currently: Student Portal accounts only,
  // see StudentsService.createPortalAccount). Login still succeeds — this
  // only signals the frontend to gate everything else behind a password
  // change until AuthService.changeMyPassword clears it.
  mustChangePassword Boolean    @default(false)

  // TOTP secret, AES-256-GCM encrypted at rest (see totp/totp-encryption.util.ts)
  // — never stored or returned in plaintext once enabled. Null means 2FA is
  // not enabled; totpEnabledAt null/non-null is the actual enabled flag
  // (mirrors mustChangePassword's "one nullable column is the whole state
  // machine" shape) rather than a separate boolean that could drift from it.
  totpSecret    String?
  totpEnabledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools           UserSchool[]
  roles             UserRole[]
  refreshTokens     RefreshToken[]
  invitations       Invitation[]
  guardian          Guardian?
  teacher           Teacher?
  student           Student?
  staff             Staff?
  notifications     Notification[]
  totpRecoveryCodes TotpRecoveryCode[]

  @@map("users")
}

// Generated once, all 10 at a time, the moment TOTP is enabled — never
// regenerated individually. Each is single-use (usedAt set the moment it's
// consumed as a login fallback) and hashed the same way a password is
// (argon2), never stored or logged in plaintext after the one response that
// shows them to the user at enable-time.
model TotpRecoveryCode {
  id       String    @id @default(uuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  usedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("totp_recovery_codes")
}

model UserSchool {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, schoolId])
  @@map("user_schools")
}

model Role {
  id   String @id @default(uuid())
  name String @unique // e.g. SUPER_ADMIN, SCHOOL_ADMIN, TEACHER, STUDENT, PARENT

  users       UserRole[]
  permissions RolePermission[]
  invitations Invitation[]

  @@map("roles")
}

model Permission {
  id  String @id @default(uuid())
  key String @unique // e.g. "students.create"

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Invitations — the only way a User ever gets a password. The User row is
// created up front (PENDING_SETUP); accepting the invite is what activates it.
// ---------------------------------------------------------------------------

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Invitation {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schoolId       String?
  school         School?       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  roleId         String
  role           Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?

  createdAt DateTime @default(now())

  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Media — metadata only. The actual bytes live in object storage (R2/S3, or
// MinIO in dev); this table never stores file content, only the key needed
// to fetch it via a short-lived signed URL. See DocumentsService.
// ---------------------------------------------------------------------------

enum MediaOwnerType {
  STUDENT
  TEACHER
  SCHOOL
  RESULT_SUBMISSION
  STAFF
}

// PHOTO is always "the latest one wins" (see DocumentsService.getPhotoUrl).
// DOCUMENT rows (e.g. a teacher's qualification/certification attachments)
// are additive — every upload is kept and listed, none are superseded.
enum MediaKind {
  PHOTO
  DOCUMENT
}

model MediaFile {
  id             String         @id @default(uuid())
  organizationId String
  schoolId       String?
  ownerType      MediaOwnerType
  ownerId        String
  kind           MediaKind      @default(PHOTO)
  label          String? // human-readable name for a DOCUMENT, e.g. "Teaching Certificate"

  storageKey       String @unique
  mimeType         String
  sizeBytes        Int
  uploadedByUserId String

  createdAt DateTime @default(now())

  @@index([ownerType, ownerId, kind])
  @@map("media_files")
}

// ---------------------------------------------------------------------------
// Audit log — append-only. No update/delete path is ever exposed for this.
// ---------------------------------------------------------------------------

enum AuditStatus {
  SUCCESS
  FAILED
  DENIED
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

model AuditLog {
  id             String  @id @default(uuid())
  organizationId String?
  schoolId       String?
  actorUserId    String?

  // Snapshots, not relations — deliberately duplicated so a historical
  // record stays readable even after the actor's own profile changes or
  // the account is gone (actorUserId already worked this way; these three
  // extend the same idea to name/email/role).
  actorNameSnapshot  String?
  actorEmailSnapshot String?
  actorRoleSnapshot  String?

  action String // e.g. "STUDENT_CREATED" — legacy rows keep their old "school.create"-style values
  module String? // e.g. "Students", "Academic", "Finance" — groups actions for filtering

  resource             String // e.g. "School", "Student"
  resourceId           String?
  resourceNameSnapshot String?

  status   AuditStatus   @default(SUCCESS)
  severity AuditSeverity @default(INFO)

  before Json?
  after  Json?
  reason String?

  ipAddress String?
  userAgent String?
  requestId String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([schoolId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resource, resourceId])
  @@index([action])
  @@index([module])
  @@index([status])
  @@index([severity])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Bulk import — CSV upload creates one batch with one row per CSV line.
// Rows that pass validation and have no duplicate concern are created
// immediately; rows with a possible duplicate stop for a human decision,
// exactly like the single-student create flow's possibleDuplicates
// response, just persisted instead of being a one-shot HTTP error. Nothing
// here bypasses StudentsService.create — every successful row is a real
// call into it, so duplicate detection, numbering, and audit logging all
// stay in one place.
// ---------------------------------------------------------------------------

enum ImportBatchStatus {
  PROCESSING
  // STAGING/READY_FOR_REVIEW/COMMITTING/FAILED are the new staged-pipeline
  // states (rows are validated + duplicate-checked before anything is
  // created — see ImportsService); PROCESSING/NEEDS_REVIEW are kept only
  // for whatever pre-existing rows already carry that value, never written
  // by new code.
  STAGING
  NEEDS_REVIEW
  READY_FOR_REVIEW
  COMMITTING
  COMPLETED
  FAILED
}

enum ImportRowStatus {
  PENDING
  // Validated and duplicate-checked, would create cleanly — nothing has
  // been written to the Student table yet. Only the commit step turns a
  // READY row into CREATED.
  READY
  CREATED
  DUPLICATE_PENDING
  ERROR
  SKIPPED
}

model ImportBatch {
  id               String            @id @default(uuid())
  organizationId   String
  schoolId         String
  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  uploadedByUserId String
  fileName         String
  status           ImportBatchStatus @default(PROCESSING)

  totalRows    Int @default(0)
  createdCount Int @default(0)
  errorCount   Int @default(0)
  pendingCount Int @default(0)
  skippedCount Int @default(0)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  rows ImportRow[]

  @@index([schoolId, createdAt])
  @@map("import_batches")
}

model ImportRow {
  id      String      @id @default(uuid())
  batchId String
  batch   ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  rowNumber Int
  rawData   Json
  status    ImportRowStatus @default(PENDING)

  studentId           String?
  errorMessage        String?
  duplicateCandidates Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId, status])
  @@map("import_rows")
}
