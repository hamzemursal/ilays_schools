generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organization & School — top of the tenant hierarchy.
// Creating a School only creates its workspace/config, never people or data.
// ---------------------------------------------------------------------------

enum SchoolType {
  PRIMARY
  SECONDARY
  PRIMARY_AND_SECONDARY
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools     School[]
  users       User[]
  students    Student[]
  invitations Invitation[]

  @@map("organizations")
}

model School {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  name    String
  type    SchoolType
  status  SchoolStatus @default(ACTIVE)
  address String?
  phone   String?
  email   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYears AcademicYear[]
  users         UserSchool[]
  divisions     Division[]
  subjects      Subject[]
  enrollments   StudentEnrollment[]
  teachers      Teacher[]
  invitations   Invitation[]
  exams         Exam[]

  @@unique([organizationId, name])
  @@map("schools")
}

model AcademicYear {
  id       String @id @default(uuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name      String // e.g. "2026"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments StudentEnrollment[]
  assignments TeacherAssignment[]
  exams       Exam[]

  @@unique([schoolId, name])
  @@map("academic_years")
}

// ---------------------------------------------------------------------------
// Academic structure — School Admin configured. Nothing here is auto-created
// by school creation except AcademicYear defaults the admin still confirms.
// ---------------------------------------------------------------------------

enum DivisionType {
  PRIMARY
  SECONDARY
}

model Division {
  id       String       @id @default(uuid())
  schoolId String
  school   School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  type     DivisionType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes Class[]

  @@unique([schoolId, type])
  @@map("divisions")
}

model Class {
  id         String   @id @default(uuid())
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  name  String // "Class 7" or "Form 2"
  level Int // ordering + promotion target lookup: 1..8 (Primary) or 1..4 (Secondary)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections      Section[]
  classSubjects ClassSubject[]
  enrollments   StudentEnrollment[]
  examSubjects  ExamSubject[]

  @@unique([divisionId, level])
  @@map("classes")
}

model Section {
  id      String @id @default(uuid())
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  name     String // "A", "B", ...
  capacity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments        StudentEnrollment[]
  teacherAssignments TeacherAssignment[]

  @@unique([classId, name])
  @@map("sections")
}

model Subject {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name String
  code String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classSubjects ClassSubject[]
  assignments   TeacherAssignment[]
  examSubjects  ExamSubject[]

  @@unique([schoolId, name])
  @@map("subjects")
}

model ClassSubject {
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([classId, subjectId])
  @@map("class_subjects")
}

// ---------------------------------------------------------------------------
// Student identity — permanent, never rewritten. Class/roll/school history
// lives only in StudentEnrollment (see architecture blueprint, section F).
// ---------------------------------------------------------------------------

enum Sex {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  COMPLETED
  GRADUATED
  TRANSFERRED
  WITHDRAWN
  ARCHIVED
}

model Student {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  firstName           String
  lastName            String
  dateOfBirth         DateTime
  sex                 Sex
  legacyStudentNumber String? // preserved from import where applicable, never used as identity
  // Denormalized for fast global lookup/reporting; the authoritative history is
  // always StudentEnrollment.status, transitioned in the same transaction as this.
  currentStatus       StudentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments StudentEnrollment[]
  guardians   StudentGuardian[]
  transfers   Transfer[]

  @@index([organizationId, lastName, dateOfBirth])
  @@map("students")
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  TRANSFERRED_OUT
  COMPLETED
  GRADUATED
  WITHDRAWN
}

model StudentEnrollment {
  id             String       @id @default(uuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  organizationId String
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  classId        String
  class          Class        @relation(fields: [classId], references: [id], onDelete: Restrict)
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  studentNumber String
  rollNumber    Int
  status        EnrollmentStatus @default(ACTIVE)
  startDate     DateTime         @default(now())
  endDate       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transfersOut  Transfer[]        @relation("TransferFrom")
  transfersIn   Transfer[]        @relation("TransferTo")
  promotionFrom PromotionItem[]   @relation("PromotionFrom")
  promotionTo   PromotionItem[]   @relation("PromotionTo")
  attendances   Attendance[]
  results       Result[]

  // Roll number is unique per school+year+class+section — but only among
  // rows sharing the same `status`. Including status in the tuple (rather
  // than just the first five columns) means a closed row (PROMOTED /
  // TRANSFERRED_OUT / etc.) never permanently reserves its roll number: a
  // new ACTIVE row can reuse it in the same section/year, while two ACTIVE
  // rows still can't collide. Postgres has no native way to express "unique
  // only where status = ACTIVE" without a partial index, which Prisma's
  // schema DSL can't declare without drifting on every future migration —
  // this achieves the same real-world guarantee without that risk.
  @@unique([schoolId, academicYearId, classId, sectionId, rollNumber, status])
  // Same reasoning as above: a promoted student keeps the same studentNumber
  // across years (see PromotionsService) and that's fine since the year
  // differs, but within one year a closed enrollment shouldn't permanently
  // block a new active student from getting that same number.
  @@unique([schoolId, academicYearId, studentNumber, status])
  @@index([studentId])
  @@map("student_enrollments")
}

// ---------------------------------------------------------------------------
// Guardians — one account can be the parent of many children across schools.
// ---------------------------------------------------------------------------

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

model Guardian {
  id     String @id @default(uuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  firstName String
  lastName  String
  phone     String?
  email     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students StudentGuardian[]

  @@index([phone])
  @@map("guardians")
}

model StudentGuardian {
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId String
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  relationship     GuardianRelationship
  isPrimaryContact Boolean              @default(false)

  @@id([studentId, guardianId])
  @@map("student_guardians")
}

// ---------------------------------------------------------------------------
// Teachers — profile is separate from login identity; assignments are what
// actually grant access to a class/section/subject in a given academic year.
// ---------------------------------------------------------------------------

enum TeacherStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

model Teacher {
  id       String @id @default(uuid())
  userId   String? @unique
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  employeeNumber String
  firstName      String
  lastName       String
  phone          String?
  email          String?
  qualification  String?
  status         TeacherStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments TeacherAssignment[]

  @@unique([schoolId, employeeNumber])
  @@map("teachers")
}

model TeacherAssignment {
  id             String       @id @default(uuid())
  teacherId      String
  teacher        Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolId       String
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([teacherId, sectionId, subjectId, academicYearId])
  @@map("teacher_assignments")
}

// ---------------------------------------------------------------------------
// Attendance — one record per enrollment per day. Authorization (a teacher
// may only mark a section they hold a TeacherAssignment for) is enforced in
// AttendanceService, not here; the schema just needs the enrollment link.
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id           String            @id @default(uuid())
  enrollmentId String
  enrollment   StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  date           DateTime         @db.Date
  status         AttendanceStatus
  markedByUserId String
  note           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, date])
  @@map("attendance_records")
}

// ---------------------------------------------------------------------------
// Exams & results — marks entry is scoped to a teacher's own
// TeacherAssignment for that class+subject+year; approval locks the mark
// against further edits (see ResultsService).
// ---------------------------------------------------------------------------

enum ExamType {
  QUIZ
  MIDTERM
  FINAL
  ASSIGNMENT
  OTHER
}

model Exam {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  name String
  type ExamType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  examSubjects ExamSubject[]

  @@unique([schoolId, academicYearId, name])
  @@map("exams")
}

model ExamSubject {
  id        String  @id @default(uuid())
  examId    String
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  maxMarks Int       @default(100)
  examDate DateTime? @db.Date

  createdAt DateTime @default(now())

  results Result[]

  @@unique([examId, classId, subjectId])
  @@map("exam_subjects")
}

enum ResultStatus {
  ENTERED
  APPROVED
}

model Result {
  id            String            @id @default(uuid())
  examSubjectId String
  examSubject   ExamSubject       @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  enrollmentId  String
  enrollment    StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  marksObtained    Decimal      @db.Decimal(6, 2)
  status           ResultStatus @default(ENTERED)
  enteredByUserId  String
  approvedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examSubjectId, enrollmentId])
  @@map("results")
}

// ---------------------------------------------------------------------------
// Transfers — never delete the student or the source enrollment.
// ---------------------------------------------------------------------------

enum TransferStatus {
  REQUESTED
  APPROVED
  REJECTED
  EXECUTED
}

model Transfer {
  id       String  @id @default(uuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  fromEnrollmentId String            @unique
  fromEnrollment   StudentEnrollment @relation("TransferFrom", fields: [fromEnrollmentId], references: [id], onDelete: Restrict)
  fromSchoolId     String
  toSchoolId       String
  toEnrollmentId   String?           @unique
  toEnrollment     StudentEnrollment? @relation("TransferTo", fields: [toEnrollmentId], references: [id], onDelete: SetNull)

  reason            String?
  status            TransferStatus @default(REQUESTED)
  requestedByUserId String
  approvedByUserId  String?
  transferDate      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromSchoolId])
  @@index([toSchoolId])
  @@map("transfers")
}

// ---------------------------------------------------------------------------
// Promotion / completion / graduation — batched, previewed, then confirmed.
// ---------------------------------------------------------------------------

enum PromotionBatchStatus {
  DRAFT
  PREVIEWED
  CONFIRMED
  REVERTED
}

enum PromotionOutcome {
  PROMOTED
  RETAINED
  COMPLETED
  GRADUATED
}

model PromotionBatch {
  id                   String   @id @default(uuid())
  schoolId             String
  fromAcademicYearId   String
  toAcademicYearId     String
  initiatedByUserId    String
  status               PromotionBatchStatus @default(DRAFT)

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  items PromotionItem[]

  @@map("promotion_batches")
}

model PromotionItem {
  id      String         @id @default(uuid())
  batchId String
  batch   PromotionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  studentId        String
  fromEnrollmentId String            @unique
  fromEnrollment   StudentEnrollment @relation("PromotionFrom", fields: [fromEnrollmentId], references: [id], onDelete: Restrict)
  toEnrollmentId   String?           @unique
  toEnrollment     StudentEnrollment? @relation("PromotionTo", fields: [toEnrollmentId], references: [id], onDelete: SetNull)

  outcome PromotionOutcome
  note    String?

  @@map("promotion_items")
}

// ---------------------------------------------------------------------------
// Identity & access — RBAC. Resource/school scope is enforced via UserSchool,
// not by the Role alone (see architecture blueprint, section E).
// ---------------------------------------------------------------------------

enum UserStatus {
  PENDING_SETUP
  ACTIVE
  SUSPENDED
}

model User {
  id             String       @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  email        String     @unique
  passwordHash String?
  status       UserStatus @default(PENDING_SETUP)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools       UserSchool[]
  roles         UserRole[]
  refreshTokens RefreshToken[]
  invitations   Invitation[]
  guardian      Guardian?
  teacher       Teacher?

  @@map("users")
}

model UserSchool {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, schoolId])
  @@map("user_schools")
}

model Role {
  id   String @id @default(uuid())
  name String @unique // e.g. SUPER_ADMIN, SCHOOL_ADMIN, TEACHER, STUDENT, PARENT

  users       UserRole[]
  permissions RolePermission[]
  invitations Invitation[]

  @@map("roles")
}

model Permission {
  id   String @id @default(uuid())
  key  String @unique // e.g. "students.create"

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Invitations — the only way a User ever gets a password. The User row is
// created up front (PENDING_SETUP); accepting the invite is what activates it.
// ---------------------------------------------------------------------------

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Invitation {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schoolId       String?
  school         School?       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  roleId         String
  role           Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?

  createdAt DateTime @default(now())

  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Audit log — append-only. No update/delete path is ever exposed for this.
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  schoolId       String?
  actorUserId    String?

  action     String // e.g. "school.create", "student.transfer"
  resource   String // e.g. "School", "Student"
  resourceId String?
  before     Json?
  after      Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([resource, resourceId])
  @@map("audit_logs")
}
