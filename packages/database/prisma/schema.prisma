generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organization & School — top of the tenant hierarchy.
// Creating a School only creates its workspace/config, never people or data.
// ---------------------------------------------------------------------------

enum SchoolType {
  PRIMARY
  SECONDARY
  PRIMARY_AND_SECONDARY
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools     School[]
  users       User[]
  students    Student[]
  invitations Invitation[]

  @@map("organizations")
}

model School {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  name    String
  type    SchoolType
  status  SchoolStatus @default(ACTIVE)
  address String?
  phone   String?
  email   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYears AcademicYear[]
  users         UserSchool[]
  divisions     Division[]
  subjects      Subject[]
  enrollments   StudentEnrollment[]
  teachers      Teacher[]
  invitations   Invitation[]
  exams         Exam[]
  feeStructures FeeStructure[]
  importBatches ImportBatch[]
  announcements Announcement[]

  @@unique([organizationId, name])
  @@map("schools")
}

model AcademicYear {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name      String // e.g. "2026"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments   StudentEnrollment[]
  assignments   TeacherAssignment[]
  exams         Exam[]
  feeStructures FeeStructure[]

  @@unique([schoolId, name])
  @@map("academic_years")
}

// ---------------------------------------------------------------------------
// Academic structure — School Admin configured. Nothing here is auto-created
// by school creation except AcademicYear defaults the admin still confirms.
// ---------------------------------------------------------------------------

enum DivisionType {
  PRIMARY
  SECONDARY
}

model Division {
  id       String       @id @default(uuid())
  schoolId String
  school   School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  type     DivisionType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes Class[]

  @@unique([schoolId, type])
  @@map("divisions")
}

model Class {
  id         String   @id @default(uuid())
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  name  String // "Class 7" or "Form 2"
  level Int // ordering + promotion target lookup: 1..8 (Primary) or 1..4 (Secondary)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections      Section[]
  classSubjects ClassSubject[]
  enrollments   StudentEnrollment[]
  examSubjects  ExamSubject[]
  feeStructures FeeStructure[]

  @@unique([divisionId, level])
  @@map("classes")
}

model Section {
  id      String @id @default(uuid())
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  name String // "A", "B", ...
  // Null means unlimited — no maximum enrollment is enforced for this
  // section. A number preserves the original fixed-capacity behavior for
  // sections created before this became optional.
  capacity Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments        StudentEnrollment[]
  teacherAssignments TeacherAssignment[]

  @@unique([classId, name])
  @@map("sections")
}

model Subject {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name String
  code String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classSubjects ClassSubject[]
  assignments   TeacherAssignment[]
  examSubjects  ExamSubject[]

  @@unique([schoolId, name])
  @@map("subjects")
}

model ClassSubject {
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([classId, subjectId])
  @@map("class_subjects")
}

// ---------------------------------------------------------------------------
// Student identity — permanent, never rewritten. Class/roll/school history
// lives only in StudentEnrollment (see architecture blueprint, section F).
// ---------------------------------------------------------------------------

enum Sex {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  COMPLETED
  GRADUATED
  TRANSFERRED
  WITHDRAWN
  ARCHIVED
}

model Student {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  // Only ever set for a student currently enrolled in a SECONDARY division
  // (see StudentsService.createPortalAccount) — the Student Portal login.
  // Mirrors Guardian.userId/Teacher.userId exactly.
  userId         String?      @unique
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  firstName           String
  lastName            String
  dateOfBirth         DateTime
  sex                 Sex
  legacyStudentNumber String? // preserved from import where applicable, never used as identity
  // Denormalized for fast global lookup/reporting; the authoritative history is
  // always StudentEnrollment.status, transitioned in the same transaction as this.
  currentStatus       StudentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments StudentEnrollment[]
  guardians   StudentGuardian[]
  transfers   Transfer[]

  @@index([organizationId, lastName, dateOfBirth])
  @@map("students")
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  TRANSFERRED_OUT
  COMPLETED
  GRADUATED
  WITHDRAWN
}

model StudentEnrollment {
  id             String       @id @default(uuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  organizationId String
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  classId        String
  class          Class        @relation(fields: [classId], references: [id], onDelete: Restrict)
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  studentNumber String
  rollNumber    Int
  status        EnrollmentStatus @default(ACTIVE)
  startDate     DateTime         @default(now())
  endDate       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transfersOut     Transfer[]        @relation("TransferFrom")
  transfersIn      Transfer[]        @relation("TransferTo")
  promotionFrom    PromotionItem[]   @relation("PromotionFrom")
  promotionTo      PromotionItem[]   @relation("PromotionTo")
  attendances      Attendance[]
  attendanceDrafts AttendanceDraft[]
  results          Result[]
  invoices         Invoice[]

  // Roll number is unique per school+year+class+section — but only among
  // rows sharing the same `status`. Including status in the tuple (rather
  // than just the first five columns) means a closed row (PROMOTED /
  // TRANSFERRED_OUT / etc.) never permanently reserves its roll number: a
  // new ACTIVE row can reuse it in the same section/year, while two ACTIVE
  // rows still can't collide. Postgres has no native way to express "unique
  // only where status = ACTIVE" without a partial index, which Prisma's
  // schema DSL can't declare without drifting on every future migration —
  // this achieves the same real-world guarantee without that risk.
  @@unique([schoolId, academicYearId, classId, sectionId, rollNumber, status])
  // Same reasoning as above: a promoted student keeps the same studentNumber
  // across years (see PromotionsService) and that's fine since the year
  // differs, but within one year a closed enrollment shouldn't permanently
  // block a new active student from getting that same number.
  @@unique([schoolId, academicYearId, studentNumber, status])
  @@index([studentId])
  @@map("student_enrollments")
}

// ---------------------------------------------------------------------------
// Guardians — one account can be the parent of many children across schools.
// ---------------------------------------------------------------------------

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum GuardianStatus {
  ACTIVE
  ARCHIVED
}

model Guardian {
  id     String  @id @default(uuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // System-generated, mirroring Student.legacyStudentNumber/Teacher.employeeNumber
  // — never typed by the admin. Nullable only because guardians created before
  // this field existed have none; every new guardian gets one.
  guardianCode String? @unique

  firstName String
  lastName  String
  phone     String?
  email     String?
  address   String?
  status    GuardianStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students      StudentGuardian[]
  notifications Notification[]

  @@index([phone])
  @@map("guardians")
}

enum StudentGuardianStatus {
  ACTIVE
  INACTIVE
}

model StudentGuardian {
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId String
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  relationship     GuardianRelationship
  isPrimaryContact Boolean               @default(false)
  // INACTIVE means "no longer an active relationship" (e.g. admin removed it)
  // without losing the historical record of who was linked to this student —
  // same non-destructive intent as Guardian.status.
  status           StudentGuardianStatus @default(ACTIVE)

  @@id([studentId, guardianId])
  @@map("student_guardians")
}

// ---------------------------------------------------------------------------
// Announcements & Notifications — minimal, additive: announcements are
// school-authored broadcasts; notifications are the per-guardian inbox rows
// derived from them. Nothing else in the system produces notifications yet,
// so this stays scoped to what the Parent Portal actually needs today rather
// than a general-purpose event bus.
// ---------------------------------------------------------------------------

enum AnnouncementAudience {
  ALL
  PARENTS
  TEACHERS
}

model Announcement {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  title           String
  body            String
  audience        AnnouncementAudience @default(ALL)
  createdByUserId String

  createdAt DateTime @default(now())

  notifications Notification[]

  @@index([schoolId, createdAt])
  @@map("announcements")
}

model Notification {
  id         String   @id @default(uuid())
  guardianId String
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  title  String
  body   String
  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([guardianId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Teachers — profile is separate from login identity; assignments are what
// actually grant access to a class/section/subject in a given academic year.
// ---------------------------------------------------------------------------

enum TeacherStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

model Teacher {
  id       String  @id @default(uuid())
  userId   String? @unique
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  employeeNumber String
  firstName      String
  lastName       String
  sex            Sex?
  dateOfBirth    DateTime?
  phone          String?
  email          String?
  address        String?
  qualification  String?
  specialization String?
  employmentDate DateTime?
  status         TeacherStatus @default(ACTIVE)

  // Self-service contact fields (see TeachersService.updateMyProfile) — a
  // teacher may keep these current themselves; everything else on this model
  // is School Admin controlled.
  emergencyContactName  String?
  emergencyContactPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments TeacherAssignment[]

  @@unique([schoolId, employeeNumber])
  @@map("teachers")
}

model TeacherAssignment {
  id             String       @id @default(uuid())
  teacherId      String
  teacher        Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolId       String
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([teacherId, sectionId, subjectId, academicYearId])
  @@map("teacher_assignments")
}

// ---------------------------------------------------------------------------
// Attendance — one record per enrollment per day. Authorization (a teacher
// may only mark a section they hold a TeacherAssignment for) is enforced in
// AttendanceService, not here; the schema just needs the enrollment link.
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id           String            @id @default(uuid())
  enrollmentId String
  enrollment   StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  date           DateTime         @db.Date
  status         AttendanceStatus
  markedByUserId String
  note           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, date])
  @@map("attendance_records")
}

// A teacher's in-progress, unfinished attendance for one section+day —
// deliberately a separate table from Attendance, not a status flag on it.
// Every dashboard/report/parent/student-portal query already reads
// Attendance directly as "real, finalized attendance"; keeping drafts out
// of that table entirely means none of those call sites need to remember
// to filter drafts out — they simply never see them. AttendanceService.mark
// (the real "Save attendance") deletes the matching draft rows once it
// writes the real Attendance rows, so a draft never outlives its submission.
model AttendanceDraft {
  id           String            @id @default(uuid())
  enrollmentId String
  enrollment   StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  date          DateTime         @db.Date
  status        AttendanceStatus
  note          String?
  savedByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, date])
  @@map("attendance_drafts")
}

// ---------------------------------------------------------------------------
// Exams & results — marks entry is scoped to a teacher's own
// TeacherAssignment for that class+subject+year; approval locks the mark
// against further edits (see ResultsService).
// ---------------------------------------------------------------------------

enum ExamType {
  QUIZ
  MIDTERM
  FINAL
  ASSIGNMENT
  OTHER
}

model Exam {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  name String
  type ExamType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  examSubjects ExamSubject[]

  @@unique([schoolId, academicYearId, name])
  @@map("exams")
}

model ExamSubject {
  id        String  @id @default(uuid())
  examId    String
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  maxMarks Int       @default(100)
  examDate DateTime? @db.Date

  createdAt DateTime @default(now())

  results Result[]

  @@unique([examId, classId, subjectId])
  @@map("exam_subjects")
}

enum ResultStatus {
  ENTERED
  APPROVED
}

model Result {
  id            String            @id @default(uuid())
  examSubjectId String
  examSubject   ExamSubject       @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  enrollmentId  String
  enrollment    StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  marksObtained    Decimal      @db.Decimal(6, 2)
  status           ResultStatus @default(ENTERED)
  enteredByUserId  String
  approvedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examSubjectId, enrollmentId])
  @@map("results")
}

// ---------------------------------------------------------------------------
// Finance — a FeeStructure is the school's own definition of a charge
// (e.g. "Term 1 Tuition — Class 7"); Invoices are generated from it against
// specific enrollments, and Payments are recorded against an invoice.
// Invoice.amount is a snapshot taken at generation time, deliberately
// decoupled from FeeStructure.amount so a later fee-structure edit never
// silently changes an already-issued invoice.
// ---------------------------------------------------------------------------

model FeeStructure {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classId        String? // null = applies across the whole school, not one class
  class          Class?       @relation(fields: [classId], references: [id], onDelete: Cascade)

  name   String
  amount Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@unique([schoolId, academicYearId, classId, name])
  @@map("fee_structures")
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model Invoice {
  id             String            @id @default(uuid())
  enrollmentId   String
  enrollment     StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  feeStructureId String
  feeStructure   FeeStructure      @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)

  amount  Decimal       @db.Decimal(10, 2)
  dueDate DateTime?     @db.Date
  status  InvoiceStatus @default(UNPAID)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  // One invoice per fee per enrollment — generating twice must not double-bill.
  @@unique([enrollmentId, feeStructureId])
  @@map("invoices")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
  OTHER
}

model Payment {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  amount           Decimal       @db.Decimal(10, 2)
  method           PaymentMethod @default(CASH)
  reference        String?
  recordedByUserId String
  paidAt           DateTime      @default(now())

  createdAt DateTime @default(now())

  @@map("payments")
}

// ---------------------------------------------------------------------------
// Transfers — never delete the student or the source enrollment.
// ---------------------------------------------------------------------------

enum TransferStatus {
  REQUESTED
  APPROVED
  REJECTED
  EXECUTED
  CANCELLED
}

model Transfer {
  id        String  @id @default(uuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  fromEnrollmentId String             @unique
  fromEnrollment   StudentEnrollment  @relation("TransferFrom", fields: [fromEnrollmentId], references: [id], onDelete: Restrict)
  fromSchoolId     String
  toSchoolId       String
  toEnrollmentId   String?            @unique
  toEnrollment     StudentEnrollment? @relation("TransferTo", fields: [toEnrollmentId], references: [id], onDelete: SetNull)

  reason            String?
  status            TransferStatus @default(REQUESTED)
  requestedByUserId String
  approvedByUserId  String?
  transferDate      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromSchoolId])
  @@index([toSchoolId])
  @@map("transfers")
}

// ---------------------------------------------------------------------------
// Promotion / completion / graduation — batched, previewed, then confirmed.
// ---------------------------------------------------------------------------

enum PromotionBatchStatus {
  DRAFT
  PREVIEWED
  CONFIRMED
  REVERTED
}

enum PromotionOutcome {
  PROMOTED
  RETAINED
  COMPLETED
  GRADUATED
}

model PromotionBatch {
  id                 String               @id @default(uuid())
  schoolId           String
  fromAcademicYearId String
  toAcademicYearId   String
  initiatedByUserId  String
  status             PromotionBatchStatus @default(DRAFT)

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  items PromotionItem[]

  @@map("promotion_batches")
}

model PromotionItem {
  id      String         @id @default(uuid())
  batchId String
  batch   PromotionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  studentId        String
  fromEnrollmentId String             @unique
  fromEnrollment   StudentEnrollment  @relation("PromotionFrom", fields: [fromEnrollmentId], references: [id], onDelete: Restrict)
  toEnrollmentId   String?            @unique
  toEnrollment     StudentEnrollment? @relation("PromotionTo", fields: [toEnrollmentId], references: [id], onDelete: SetNull)

  outcome PromotionOutcome
  note    String?

  @@map("promotion_items")
}

// ---------------------------------------------------------------------------
// Identity & access — RBAC. Resource/school scope is enforced via UserSchool,
// not by the Role alone (see architecture blueprint, section E).
// ---------------------------------------------------------------------------

enum UserStatus {
  PENDING_SETUP
  ACTIVE
  SUSPENDED
}

model User {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  email        String     @unique
  passwordHash String?
  status       UserStatus @default(PENDING_SETUP)
  // Set on any account whose password was assigned by an admin rather than
  // chosen by the account holder (currently: Student Portal accounts only,
  // see StudentsService.createPortalAccount). Login still succeeds — this
  // only signals the frontend to gate everything else behind a password
  // change until AuthService.changeMyPassword clears it.
  mustChangePassword Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools       UserSchool[]
  roles         UserRole[]
  refreshTokens RefreshToken[]
  invitations   Invitation[]
  guardian      Guardian?
  teacher       Teacher?
  student       Student?

  @@map("users")
}

model UserSchool {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, schoolId])
  @@map("user_schools")
}

model Role {
  id   String @id @default(uuid())
  name String @unique // e.g. SUPER_ADMIN, SCHOOL_ADMIN, TEACHER, STUDENT, PARENT

  users       UserRole[]
  permissions RolePermission[]
  invitations Invitation[]

  @@map("roles")
}

model Permission {
  id  String @id @default(uuid())
  key String @unique // e.g. "students.create"

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Invitations — the only way a User ever gets a password. The User row is
// created up front (PENDING_SETUP); accepting the invite is what activates it.
// ---------------------------------------------------------------------------

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Invitation {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schoolId       String?
  school         School?       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  roleId         String
  role           Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?

  createdAt DateTime @default(now())

  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Media — metadata only. The actual bytes live in object storage (R2/S3, or
// MinIO in dev); this table never stores file content, only the key needed
// to fetch it via a short-lived signed URL. See DocumentsService.
// ---------------------------------------------------------------------------

enum MediaOwnerType {
  STUDENT
  TEACHER
  SCHOOL
}

// PHOTO is always "the latest one wins" (see DocumentsService.getPhotoUrl).
// DOCUMENT rows (e.g. a teacher's qualification/certification attachments)
// are additive — every upload is kept and listed, none are superseded.
enum MediaKind {
  PHOTO
  DOCUMENT
}

model MediaFile {
  id             String         @id @default(uuid())
  organizationId String
  schoolId       String?
  ownerType      MediaOwnerType
  ownerId        String
  kind           MediaKind      @default(PHOTO)
  label          String? // human-readable name for a DOCUMENT, e.g. "Teaching Certificate"

  storageKey       String @unique
  mimeType         String
  sizeBytes        Int
  uploadedByUserId String

  createdAt DateTime @default(now())

  @@index([ownerType, ownerId, kind])
  @@map("media_files")
}

// ---------------------------------------------------------------------------
// Audit log — append-only. No update/delete path is ever exposed for this.
// ---------------------------------------------------------------------------

enum AuditStatus {
  SUCCESS
  FAILED
  DENIED
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

model AuditLog {
  id             String  @id @default(uuid())
  organizationId String?
  schoolId       String?
  actorUserId    String?

  // Snapshots, not relations — deliberately duplicated so a historical
  // record stays readable even after the actor's own profile changes or
  // the account is gone (actorUserId already worked this way; these three
  // extend the same idea to name/email/role).
  actorNameSnapshot  String?
  actorEmailSnapshot String?
  actorRoleSnapshot  String?

  action String // e.g. "STUDENT_CREATED" — legacy rows keep their old "school.create"-style values
  module String? // e.g. "Students", "Academic", "Finance" — groups actions for filtering

  resource             String // e.g. "School", "Student"
  resourceId           String?
  resourceNameSnapshot String?

  status   AuditStatus   @default(SUCCESS)
  severity AuditSeverity @default(INFO)

  before Json?
  after  Json?
  reason String?

  ipAddress String?
  userAgent String?
  requestId String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([schoolId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resource, resourceId])
  @@index([action])
  @@index([module])
  @@index([status])
  @@index([severity])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Bulk import — CSV upload creates one batch with one row per CSV line.
// Rows that pass validation and have no duplicate concern are created
// immediately; rows with a possible duplicate stop for a human decision,
// exactly like the single-student create flow's possibleDuplicates
// response, just persisted instead of being a one-shot HTTP error. Nothing
// here bypasses StudentsService.create — every successful row is a real
// call into it, so duplicate detection, numbering, and audit logging all
// stay in one place.
// ---------------------------------------------------------------------------

enum ImportBatchStatus {
  PROCESSING
  NEEDS_REVIEW
  COMPLETED
}

enum ImportRowStatus {
  PENDING
  CREATED
  DUPLICATE_PENDING
  ERROR
  SKIPPED
}

model ImportBatch {
  id               String            @id @default(uuid())
  organizationId   String
  schoolId         String
  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  uploadedByUserId String
  fileName         String
  status           ImportBatchStatus @default(PROCESSING)

  totalRows    Int @default(0)
  createdCount Int @default(0)
  errorCount   Int @default(0)
  pendingCount Int @default(0)
  skippedCount Int @default(0)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  rows ImportRow[]

  @@index([schoolId, createdAt])
  @@map("import_batches")
}

model ImportRow {
  id      String      @id @default(uuid())
  batchId String
  batch   ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  rowNumber Int
  rawData   Json
  status    ImportRowStatus @default(PENDING)

  studentId           String?
  errorMessage        String?
  duplicateCandidates Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId, status])
  @@map("import_rows")
}
